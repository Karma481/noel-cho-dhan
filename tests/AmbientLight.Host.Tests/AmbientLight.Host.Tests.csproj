<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host tests: stage orchestration with fake stages, configuration load/repair/autosave on a temporary folder
    with a fake clock, registry rules on an in-memory registry, fullscreen debouncing and status texts.
    No Win32, GPU or registry access, so they also run on non-Windows CI agents.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AmbientLight.Host\AmbientLight.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
