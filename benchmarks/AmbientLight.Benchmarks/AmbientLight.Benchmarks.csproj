<Project Sdk="Microsoft.NET.Sdk">
  <!-- Run with: dotnet run -c Release (in this folder), then pick a benchmark or pass a filter argument. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires public, non-sealed benchmark classes and discovers methods by reflection. -->
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AmbientLight.Processing\AmbientLight.Processing.csproj" />
  </ItemGroup>
</Project>
