<Project>
  <!-- Evaluated after each project file, so properties the project sets (IsTestProject) are visible here. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- xUnit test method names use underscores by convention. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CS1591</NoWarn>
  </PropertyGroup>
</Project>
