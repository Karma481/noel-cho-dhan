<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stage T2 of the pipeline: letterbox detection and the CPU color pipeline.
    Consumes ZoneSampleFrame from the capture stage, produces FrameData for the overlay and serial stages.
    Platform-agnostic (no Windows APIs) so all of it is unit-testable on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AmbientLight.Processing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmbientLight.Core\AmbientLight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AmbientLight.Processing.Tests" />
    <InternalsVisibleTo Include="AmbientLight.Benchmarks" />
  </ItemGroup>
</Project>
