<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stage T4 of the pipeline: Adalight frames to an LED controller over a serial port.
    The port is driven through the Win32 comm API directly (see Ports/Win32SerialPort.cs for why).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AmbientLight.Serial</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmbientLight.Core\AmbientLight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AmbientLight.Serial.Tests" />
  </ItemGroup>
</Project>
