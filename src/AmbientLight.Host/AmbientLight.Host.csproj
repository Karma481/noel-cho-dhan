<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Composition and lifecycle of the pipeline, independent of any UI framework:
    which stages run (orchestrator), configuration persistence (load, repair, debounced autosave) and the
    Windows integration a tray app needs (autostart, GPU preference, fullscreen detection, single instance).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AmbientLight.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmbientLight.Core\AmbientLight.Core.csproj" />
    <ProjectReference Include="..\AmbientLight.Capture\AmbientLight.Capture.csproj" />
    <ProjectReference Include="..\AmbientLight.Processing\AmbientLight.Processing.csproj" />
    <ProjectReference Include="..\AmbientLight.Overlay\AmbientLight.Overlay.csproj" />
    <ProjectReference Include="..\AmbientLight.Serial\AmbientLight.Serial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AmbientLight.Host.Tests" />
  </ItemGroup>
</Project>
