<Window x:Class="AmbientLight.App.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambient Light — Settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AmbientLight.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name, pipeline state, pause/resume -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="Ambient Light" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ModeText}" />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorText}" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource AccentButton}"
                    Content="{Binding PauseButtonText}"
                    Command="{Binding TogglePauseCommand}"
                    ToolTip="Pause or resume the whole effect (Ctrl+Alt+L)" />
        </Grid>

        <!-- MinHeight fits the tallest tab, so the window keeps its size when switching tabs. -->
        <TabControl Grid.Row="1"
                    MinHeight="400"
                    Margin="0,14,0,0"
                    Style="{StaticResource ChipTabs}">

            <!-- ── Virtual Overlay ─────────────────────────────────────────── -->
            <TabItem Header="Virtual Overlay">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OverlayEnabled}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Show the glow overlay" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Click-through and always on top, yet invisible to screenshots, recordings and screen sharing. Ctrl+Alt+O toggles it." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}" IsEnabled="{Binding OverlayEnabled}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Brightness" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding OverlayBrightness, StringFormat={}{0:0} %}" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="1"
                                    LargeChange="10"
                                    Value="{Binding OverlayBrightness}"
                                    AutomationProperties.Name="Brightness" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Opacity" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Opacity, StringFormat={}{0:0} %}" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="1"
                                    LargeChange="10"
                                    Value="{Binding Opacity}"
                                    AutomationProperties.Name="Opacity" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Spread width" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding SpreadWidth, StringFormat={}{0:0.0} % of screen}" />
                            </Grid>
                            <Slider Minimum="0.5"
                                    Maximum="25"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.5"
                                    LargeChange="2"
                                    Value="{Binding SpreadWidth}"
                                    AutomationProperties.Name="Spread width" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Thickness of the solid color band along each edge." />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="Blur radius" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding BlurRadius, StringFormat={}{0:0.0} % of screen}" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="25"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.5"
                                    LargeChange="2"
                                    Value="{Binding BlurRadius}"
                                    AutomationProperties.Name="Blur radius" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="How far the glow fades into the picture. 0 gives hard-edged bands." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ── Performance & Mode ──────────────────────────────────────── -->
            <TabItem Header="Performance &amp; Mode">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelText}" Text="Target frame rate" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="How often the screen is sampled and the glow updated. 30 FPS about halves the work, for battery use." />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <!-- Distinct group names: the bindings alone decide which segment is checked. -->
                                <RadioButton Style="{StaticResource SegmentButton}"
                                             GroupName="Fps30"
                                             Content="30 FPS"
                                             IsChecked="{Binding IsPowerSavingFps}" />
                                <RadioButton Style="{StaticResource SegmentButton}"
                                             GroupName="Fps60"
                                             Content="60 FPS"
                                             IsChecked="{Binding IsSmoothFps}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource WarningText}" Text="{Binding CustomFpsText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PauseOverlayInExclusiveFullscreen}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Hide the overlay in exclusive fullscreen" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Windows cannot draw over an exclusive-fullscreen game, so the overlay is released until the game exits. The LED strip keeps running." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PreferPowerSavingGpu}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Use the power-saving GPU" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="On laptops with two GPUs the built-in screen is driven by the integrated one, the only GPU that can capture it. Applies from the next start." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Start with Windows" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding StartupHint}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ── Hardware LED ────────────────────────────────────────────── -->
            <TabItem Header="Hardware LED">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SerialEnabled}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Drive an LED strip" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Adalight over USB serial to an ESP32 or Arduino. While this is off, no serial thread runs and no port is opened." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="COM port" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort}"
                                      AutomationProperties.Name="COM port" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource SubtleButton}"
                                    Content="Refresh"
                                    Command="{Binding RefreshPortsCommand}"
                                    ToolTip="List the serial ports again (after plugging in the controller)" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource LabelText}"
                                       Text="Baud rate" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding BaudRates}"
                                      SelectedItem="{Binding BaudRate}"
                                      ItemStringFormat="{}{0:N0}"
                                      AutomationProperties.Name="Baud rate" />

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Text="Must match SERIAL_BAUD_RATE of the firmware (firmware/esp32-adalight, 1,000,000 by default). Boards with native USB (ESP32-S2/S3/C3) ignore it." />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer: live status of every stage, validation and save problems, links -->
        <Border Grid.Row="2"
                Margin="0,4,0,0"
                Padding="0,10,0,0"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource StatusLine}" Text="{Binding CaptureStatusText}" />
                <TextBlock Style="{StaticResource StatusLine}" Text="{Binding OverlayStatusText}" />
                <TextBlock Style="{StaticResource StatusLine}" Text="{Binding SerialStatusText}" />
                <TextBlock Style="{StaticResource WarningText}" Text="{Binding IssuesText}" />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding SaveStatusText}" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource LinkButton}"
                            Content="config.json"
                            Command="{Binding OpenConfigCommand}"
                            ToolTip="Show the settings file in Explorer (changes are saved automatically)" />
                    <Button DockPanel.Dock="Left"
                            Margin="12,0,0,0"
                            Style="{StaticResource LinkButton}"
                            Content="Logs"
                            Command="{Binding OpenLogsCommand}"
                            ToolTip="Open the log folder" />
                    <TextBlock Margin="12,0,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource StatusLine}"
                               Text="{Binding HotkeysText}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
