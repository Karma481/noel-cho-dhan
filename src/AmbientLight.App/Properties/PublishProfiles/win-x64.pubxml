<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained AmbientLight.exe for 64-bit Windows 10 2004+ / Windows 11. No .NET installation needed.

    dotnet publish src/AmbientLight.App -p:PublishProfile=win-x64

  Output: artifacts/publish/win-x64/AmbientLight.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Precompiled native code: fast start at sign-in without waiting for the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF's native libraries go inside the exe too; they are extracted once to %TEMP%\.net on first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Not compressed on purpose: a compressed bundle is inflated into private memory at every start, which
      adds tens of MB of RAM for the whole lifetime of a tray app. Uncompressed assemblies are memory-mapped
      from the exe and shared with the file cache. Pass -p:EnableCompressionInSingleFile=true for a smaller
      download instead.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
